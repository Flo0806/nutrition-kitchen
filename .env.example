# Server: read by compose.example.yml
APP_PORT=3000

# Seals the session cookie, at least 32 random characters (openssl rand -base64 32)
NUXT_APP_SECRET=

# Google login (Google Auth Platform > Clients)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# On the server behind a proxy: https://nutrition-kitchen.fh-softdev.de/auth/google. Locally leave it empty.
NUXT_OAUTH_GOOGLE_REDIRECT_URL=

# Local: token for scripts/release.sh to push the release commit and tag.
# Fine-grained PAT for Flo0806/nutrition-kitchen with "Contents: Read and write".
# Optional, without it the script uses your normal git auth.
GH_TOKEN=
